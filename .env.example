# ============================================
# SalmoSUR S.A. - Configuración (EP1+EP2 ISY0101)
# Copia este archivo a .env y completa los valores
# ============================================

# --- Credenciales Groq (https://console.groq.com) ---
GROQ_API_KEY="gsk_tu_api_key_aqui"
GROQ_MODEL="qwen/qwen3.8-27b"
GROQ_MODEL_FAST="openai/gpt-oss-20b"
EMBEDDING_MODEL="sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2"

# --- Agente (EP2): pacing/retries para el límite TPM del tier gratuito ---
AGENTE_PACING=2.5
GROQ_MAX_RETRIES=5
AGENTE_MAX_TOKENS=1400
# Dispositivo de embeddings: cpu (defecto) o cuda
RAG_DEVICE=cpu

# --- Conexión PostgreSQL (dashboard) ---
PGHOST="localhost"
PGPORT="5432"
PGUSER="salmonera"
PGPASSWORD="salmonera123"
PGDATABASE="salmonera_pm"

# --- Servidor ---
PORT=4000

# --- Intérprete Python con las dependencias RAG ---
